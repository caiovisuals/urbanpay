# URL do serviço Java. O navegador nunca acessa diretamente: só as rotas /api do Next.
CORE_API_URL="http://localhost:8080"
JWT_ISSUER="urbanpay-core"

# Quantos proxies confiáveis (load balancer, CDN) ficam na frente do Next. Usado para achar o
# IP real do usuário no X-Forwarded-For e repassá-lo ao core (rate limit).
TRUSTED_PROXY_HOPS=1

DB_URL="jdbc:postgresql://localhost:5432/urbanpay"
DB_USER="urbanpay"
DB_PASSWORD="urbanpay"

# Chaves RSA em PEM
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""